;
; RP2040, SN74LVC245A: GP16=DIR (IC pin 1), GP18=/OE (IC pin 19).
; GP16 and GP18 are NOT adjacent: SET controls DIR and side-set controls /OE.
; DIR=1: Pico A -> ESC B; DIR=0: ESC B -> Pico A.
; /OE=1: outputs disabled (Hi-Z); /OE=0: enabled.
; PIO1 shifter controller; four motor DShot SMs are on PIO0.
; RP2040 cannot hardware-sync across PIO blocks. This adjusted program
; tolerates a short CPU dispatch skew but REQUIRES scope validation.
; Mandatory: external 3.3V pull-up on /OE; scope-check timing before ESC tests.
.program pico_shifter_rp2040
.side_set 1
.wrap_target
    set pins, 1 side 1        ; select transmit direction; disabled
    nop side 1 [3]         ; earlier TX enable to accommodate start skew
    set pins, 1 side 0        ; enable A->B for DShot frame
    set x, 31 side 0
tx_wait:
    nop side 0 [15]
    jmp x-- tx_wait side 0 [3] ; 20 cycles per iteration, unchanged
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]         ; delay disabling until motors release GPIO
    set pins, 1 side 1        ; disable BEFORE switching direction
    nop side 1 [15]
    set pins, 0 side 1        ; select B->A, still disabled
    nop side 1 [15]
    set pins, 0 side 0        ; enable receiving path
    set x, 31 side 0
rx_window:
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    jmp x-- rx_window side 0 ; 97 cycles per iteration, unchanged
    set pins, 0 side 1        ; disable until next 400Hz frame
    pull block side 1        ; stall until next synchronized restart
.wrap
