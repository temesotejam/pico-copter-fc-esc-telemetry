;
; RP2350 GPIO17 dedicated ESC TX pad, PIO UART RX 115200 8N1.
; Based on Raspberry Pi pico-examples/pio/uart_rx (BSD-3-Clause).
.program pico2_uart_rx
.wrap_target
start:
    wait 0 pin 0
    set x, 7 [10]
bitloop:
    in pins, 1
    jmp x-- bitloop [6]
    jmp pin good_stop
    wait 1 pin 0
    jmp start
good_stop:
    push
.wrap
